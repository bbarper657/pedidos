{% extends 'base.html.twig' %}

{% block title %}Hello CategoriasController!{% endblock %}

{% block body %}
    <h1>CATEGORIAS</h1>
    {% for categoria in categorias %}
        <p><a href="{{ path('productos', {'categoria_id': categoria.getId()}) }}">{{ categoria.getNombre }}</a></p>
            
        {% endfor %}
{% endblock %}
