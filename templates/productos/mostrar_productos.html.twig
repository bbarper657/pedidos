{% extends 'base.html.twig' %}
{% block title %}Nuestros Productos{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/productos.css') }}">
{% endblock %}

{% block contenido %}
    <div class="container">
        <div class="header-seccion">
            <h1>Nuestros Productos</h1>
            <p style="color: #64748b;">Añade al carrito los artículos que necesites</p>
        </div>
        <form action="{{ path('anadir') }}" method="post">
            <div class="productos-wrapper">
                <div class="table-head">
                    <div>Producto</div>
                    <div>Descripción</div>
                    <div>Precio</div>
                    <div>Cantidad</div>
                </div>
                {% for producto in productos %}
                    <div class="producto-row">
                        <div class="p-nombre-corto">
                            {{ producto.getNombreCorto() }}
                            <div style="font-size: 0.75rem; font-weight: 400; color: #94a3b8; margin-top: 4px;">
                                {{ producto.getNombre() }}
                            </div>
                        </div>
                        <div class="p-descripcion">
                            {{ producto.getDescripcion() }}
                        </div>
                        <div class="p-precio">
                            {{ producto.getPrecio() }}€
                        </div>
                        <div>
                            <input type="number" 
                                   name="unidades[]" 
                                   value="0" 
                                   min="0" 
                                   class="input-unidades">
                            <input type="hidden" name="productos_id[]" value="{{ producto.getId() }}">
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="btn-submit-container">
                <button type="submit" name="enviar" class="btn-enviar">
                    Añadir a la cesta
                </button>
            </div>
        </form>
    </div>
{% endblock %}