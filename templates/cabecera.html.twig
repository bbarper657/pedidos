{% if app.user %}
    <style>
        /* Cabecera principal */
        .header {
            background-color: #2c3e50;
            color: white;
            padding: 15px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 3px solid #e67e22;
            font-family: Arial, sans-serif;
        }

        /* Logo / nombre tienda */
        .header .logo {
            font-size: 1.5em;
            font-weight: bold;
        }

        /* Saludo usuario */
        .header .saludo {
            margin-right: 20px;
        }

        /* Navegación */
        .header nav a {
            color: white;
            text-decoration: none;
            margin-right: 15px;
            font-weight: bold;
            transition: color 0.3s;
        }

        /* Efecto hover en enlaces */
        .header nav a:hover {
            color: #e67e22;
        }
    </style>

    <header class="header">

        <!-- Logo o nombre de la tienda -->
        <div class="logo">MiTienda</div>

        <!-- Saludo usuario -->
        <div class="saludo">Bienvenid@ <strong>{{ app.user.login }}</strong></div>

        <!-- Menú de navegación -->
        <nav>
            <a href="{{ path('categorias') }}">Categorias</a>
            <a href="{{ path('cesta') }}">Cesta</a>
            <a href="{{ path('logout') }}">Logout</a>
        </nav>

    </header>
{% endif %}
